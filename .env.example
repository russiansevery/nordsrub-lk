# Скопируйте в .env на сервере и заполните. Файл .env в репозиторий не попадает.

# Адрес кабинета (для ссылок в письмах)
APP_URL=https://lk.nordsrub.ru

# PostgreSQL
DATABASE_URL=postgres://lk:password@localhost:5432/lk

# Входящий вебхук Битрикс24 только для кабинета (права: crm, disk, user, im, task).
# Вид: https://nordsrub.bitrix24.ru/rest/<id>/<ключ>/
# Пусто = демо-режим: главная показывает тестовый объект, Битрикс не вызывается.
BITRIX_WEBHOOK_URL=

# Секрет, который бизнес-процесс «Открыть личный кабинет» передаёт в запросе.
# Сгенерировать: openssl rand -hex 24
INVITE_SECRET=

# Почта для приглашений: smtp://user:pass@smtp.example.ru:465
# Пусто = письма пишутся в лог (только для разработки).
SMTP_URL=
MAIL_FROM="Русский Север <info@nordsrub.ru>"

# Режим показа: если пусты и BITRIX_WEBHOOK_URL, и DATABASE_URL, кабинет работает без базы
# с одним демо-аккаунтом. Для показа руководству поменяйте пароль.
DEMO_EMAIL=demo@nordsrub.ru
DEMO_PASSWORD=demo2026
